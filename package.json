    "images": "bash docker/build.sh"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.1.0",
    "monaco-editor": "^0.57.0",
    "typescript": "^5.8.0"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
